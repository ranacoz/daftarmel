<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>e-DaftarMel | Sistem Daftar Mel Bayaran</title>
  <style>
    :root {
      /* Liquid Glass Translucency & Refractive Tokens */
      --glass-white-base: rgba(255, 255, 255, 0.74);
      --glass-white-elevated: rgba(255, 255, 255, 0.88);
      --glass-white-subtle: rgba(248, 250, 252, 0.65);
      --glass-input: rgba(255, 255, 255, 0.82);
      --glass-row-hover: rgba(241, 245, 249, 0.75);

      /* Optical Blur, Saturation & Refractive Depth */
      --glass-blur-xs: 8px;
      --glass-blur-sm: 14px;
      --glass-blur-md: 22px;
      --glass-blur-lg: 36px;
      --glass-saturate: 190%;

      /* Frosted Specular Borders, Prismatic Sheen & Inner Highlights */
      --glass-border: rgba(255, 255, 255, 0.88);
      --glass-border-subtle: rgba(226, 232, 240, 0.8);
      --glass-border-focus: #2563eb;
      --glass-inner-specular: inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.98), inset 0 -1px 1px 0 rgba(255, 255, 255, 0.4);
      --glass-sheen: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0.25) 100%);
      --glass-shadow: 0 14px 34px -6px rgba(15, 23, 42, 0.06), 0 4px 14px -2px rgba(15, 23, 42, 0.03);
      --glass-shadow-float: 0 24px 48px -10px rgba(15, 23, 42, 0.14), 0 8px 20px -4px rgba(15, 23, 42, 0.06);

      /* Controlled Blue Accent Palette */
      --accent-blue: #2563eb;
      --accent-blue-hover: #1d4ed8;
      --accent-blue-subtle: rgba(239, 246, 255, 0.85);
      --accent-blue-border: rgba(191, 219, 254, 0.9);
      --accent-blue-glow: rgba(37, 99, 235, 0.2);

      /* Functional Accent Hierarchy */
      --accent-emerald: #059669;
      --accent-emerald-subtle: rgba(236, 253, 245, 0.85);
      --accent-emerald-border: rgba(167, 243, 208, 0.9);
      --accent-amber: #d97706;
      --accent-rose: #dc2626;
      --accent-rose-subtle: rgba(254, 242, 242, 0.85);
      --accent-rose-border: rgba(254, 202, 202, 0.9);

      /* High-Contrast Clear Slate Typography */
      --text-main: #0f172a;
      --text-sub: #334155;
      --text-muted: #64748b;
      --text-dim: #94a3b8;

      /* Refined Geometric Radii */
      --radius-xs: 8px;
      --radius-sm: 12px;
      --radius-md: 16px;
      --radius-lg: 20px;
      --radius-window: 26px;

      /* Smooth Fluid Transitions */
      --transition-smooth: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
      --transition-drawer: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s ease;
    }

    @font-face {
      font-family: 'SF Pro Display';
      font-style: normal;
      font-weight: 400;
      src: local('SF Pro Display'), local('SFProDisplay-Regular'),
           url('https://cdn.jsdelivr.net/npm/@fontsource/sf-pro-display@latest/files/sf-pro-display-latin-400-normal.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'SF Pro Display';
      font-style: normal;
      font-weight: 600;
      src: local('SF Pro Display Semibold'), local('SFProDisplay-Semibold'),
           url('https://cdn.jsdelivr.net/npm/@fontsource/sf-pro-display@latest/files/sf-pro-display-latin-600-normal.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'SF Pro Display';
      font-style: normal;
      font-weight: 700;
      src: local('SF Pro Display Bold'), local('SFProDisplay-Bold'),
           url('https://cdn.jsdelivr.net/npm/@fontsource/sf-pro-display@latest/files/sf-pro-display-latin-700-normal.woff2') format('woff2');
      font-display: swap;
    }

    *, *::before, *::after, button, input, select, textarea {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      background-color: #f8fafc;
      background-image:
        radial-gradient(circle at 10% 12%, rgba(219, 234, 254, 0.6) 0%, transparent 42%),
        radial-gradient(circle at 90% 18%, rgba(241, 245, 249, 0.8) 0%, transparent 48%),
        radial-gradient(circle at 50% 86%, rgba(224, 242, 254, 0.5) 0%, transparent 52%),
        linear-gradient(160deg, #f8fafc 0%, #f1f5f9 55%, #e2e8f0 100%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.5;
      padding: 24px;
      position: relative;
      overflow-x: hidden;
    }

    .app-container {
      max-width: 1440px;
      margin: 0 auto;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
      z-index: 1;
    }

    /* Liquid Glass Panels */
    .white-panel {
      background: var(--glass-white-base);
      backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturate));
      -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturate));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-window);
      box-shadow: var(--glass-shadow), var(--glass-inner-specular);
      transition: var(--transition-smooth);
      position: relative;
    }

    .white-panel::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-window);
      background: var(--glass-sheen);
      opacity: 0.25;
      pointer-events: none;
    }

    .white-panel:hover {
      background: var(--glass-white-elevated);
      border-color: rgba(255, 255, 255, 0.98);
      box-shadow: 0 18px 40px -4px rgba(15, 23, 42, 0.08), 0 4px 14px -2px rgba(15, 23, 42, 0.04), var(--glass-inner-specular);
    }

    header.main-header {
      padding: 16px 24px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .emblem-icon {
      width: 44px;
      height: 44px;
      background: var(--accent-blue-subtle);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border: 1px solid var(--accent-blue-border);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-blue);
      box-shadow: inset 0 1px 1.5px rgba(255, 255, 255, 0.9), 0 4px 14px rgba(37, 99, 235, 0.08);
      transition: var(--transition-smooth);
    }

    .emblem-icon:hover {
      background: #dbeafe;
      transform: translateY(-1px);
    }

    .brand-text h1 {
      font-size: 1.28rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .version-tag {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--accent-blue-subtle);
      color: var(--accent-blue);
      border: 1px solid var(--accent-blue-border);
      letter-spacing: 0.03em;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .brand-text p {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .system-status {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .live-clock {
      text-align: right;
      font-size: 0.75rem;
      color: var(--text-muted);
      padding-left: 16px;
      border-left: 1px solid var(--glass-border-subtle);
    }

    .live-clock span.time {
      display: block;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      font-variant-numeric: tabular-nums;
      font-family: 'SF Mono', ui-monospace, Menlo, monospace;
      letter-spacing: 0.02em;
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .metric-card {
      padding: 18px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: var(--radius-lg);
      background: var(--glass-white-base);
      backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturate));
      -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturate));
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-shadow), var(--glass-inner-specular);
      transition: var(--transition-smooth);
      position: relative;
    }

    .metric-card:hover {
      background: var(--glass-white-elevated);
      border-color: rgba(255, 255, 255, 0.98);
      box-shadow: 0 16px 36px -4px rgba(15, 23, 42, 0.07), var(--glass-inner-specular);
    }

    .metric-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .metric-info h3 {
      font-size: 0.725rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      font-weight: 600;
    }

    .metric-info .metric-num {
      font-size: 1.85rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--text-main);
      line-height: 1.1;
      font-variant-numeric: tabular-nums;
    }

    .metric-subtext {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .metric-icon-badge {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(248, 250, 252, 0.75);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      color: var(--text-muted);
      border: 1px solid var(--glass-border);
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.9);
    }

    .metric-icon-badge.accent-blue {
      background: var(--accent-blue-subtle);
      color: var(--accent-blue);
      border-color: var(--accent-blue-border);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-size: 0.825rem;
      font-weight: 600;
      padding: 9px 18px;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      cursor: pointer;
      transition: var(--transition-smooth);
      outline: none;
      text-decoration: none;
      white-space: nowrap;
      user-select: none;
      position: relative;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary {
      background: var(--accent-blue);
      border-color: rgba(255, 255, 255, 0.25);
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25), inset 0 1px 1.5px rgba(255, 255, 255, 0.38);
    }

    .btn-primary:hover {
      background: var(--accent-blue-hover);
      border-color: rgba(255, 255, 255, 0.35);
      box-shadow: 0 6px 18px rgba(37, 99, 235, 0.32), inset 0 1px 1.5px rgba(255, 255, 255, 0.45);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border: 1px solid var(--glass-border);
      color: var(--text-sub);
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03), inset 0 1px 1.5px rgba(255, 255, 255, 0.95);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.95);
      border-color: rgba(203, 213, 225, 0.95);
      color: var(--accent-blue);
      transform: translateY(-1px);
    }

    .btn-danger {
      background: var(--accent-rose-subtle);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border-color: var(--accent-rose-border);
      color: var(--accent-rose);
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.85);
    }

    .btn-danger:hover {
      background: #fee2e2;
      border-color: #fca5a5;
      color: #b91c1c;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 0.75rem;
      border-radius: var(--radius-xs);
    }

    .controls-panel {
      padding: 16px 22px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .controls-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
    }

    .search-box-wrapper {
      position: relative;
      flex: 1;
      min-width: 290px;
    }

    .search-box-wrapper svg {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
      pointer-events: none;
      transition: var(--transition-smooth);
    }

    .search-input {
      width: 100%;
      padding: 9px 44px 9px 40px;
      background: var(--glass-input);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-sm);
      color: var(--text-main);
      font-size: 0.85rem;
      outline: none;
      box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03), inset 0 1px 1.5px rgba(255, 255, 255, 0.9);
      transition: var(--transition-smooth);
    }

    .search-input::placeholder {
      color: var(--text-dim);
    }

    .search-input:focus {
      background: #ffffff;
      border-color: var(--glass-border-focus);
      box-shadow: 0 0 0 3px var(--accent-blue-glow), inset 0 1px 1px rgba(255, 255, 255, 1);
    }

    .search-input:focus + svg {
      color: var(--accent-blue);
    }

    .kbd-shortcut {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--text-muted);
      background: rgba(241, 245, 249, 0.7);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid var(--glass-border);
      padding: 2px 6px;
      border-radius: 6px;
      pointer-events: none;
    }

    .action-group {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .filter-badge-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-blue);
      color: #ffffff;
      font-size: 0.68rem;
      font-weight: 700;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      margin-left: 2px;
      box-shadow: 0 2px 5px rgba(37, 99, 235, 0.35);
    }

    .filter-badge-count.hidden {
      display: none;
    }

    /* Modern Glassmorphic Off-Canvas Sidebar */
    .sidebar-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.32);
      backdrop-filter: blur(var(--glass-blur-sm)) saturate(160%);
      -webkit-backdrop-filter: blur(var(--glass-blur-sm)) saturate(160%);
      z-index: 1040;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.28s ease, visibility 0.28s ease;
    }

    .sidebar-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .filter-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      width: 380px;
      max-width: 90vw;
      height: 100vh;
      background: var(--glass-white-elevated);
      backdrop-filter: blur(var(--glass-blur-lg)) saturate(200%);
      -webkit-backdrop-filter: blur(var(--glass-blur-lg)) saturate(200%);
      border-left: 1px solid rgba(255, 255, 255, 0.95);
      box-shadow: -12px 0 38px rgba(15, 23, 42, 0.12), var(--glass-inner-specular);
      z-index: 1050;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: var(--transition-drawer);
    }

    .filter-sidebar.active {
      transform: translateX(0);
    }

    .sidebar-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--glass-border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.6);
    }

    .sidebar-header-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .sidebar-header-title svg {
      color: var(--accent-blue);
    }

    .sidebar-body {
      padding: 24px;
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .sidebar-footer {
      padding: 16px 24px;
      border-top: 1px solid var(--glass-border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(248, 250, 252, 0.7);
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .filter-group label {
      font-size: 0.735rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .custom-select {
      background: var(--glass-input);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border: 1px solid var(--glass-border);
      color: var(--text-sub);
      padding: 9px 13px;
      border-radius: var(--radius-sm);
      font-size: 0.825rem;
      outline: none;
      cursor: pointer;
      width: 100%;
      box-shadow: inset 0 1px 1.5px rgba(255, 255, 255, 0.9);
      transition: var(--transition-smooth);
    }

    .custom-select:focus {
      background: #ffffff;
      border-color: var(--glass-border-focus);
      box-shadow: 0 0 0 3px var(--accent-blue-glow);
    }

    .custom-select option {
      background: #ffffff;
      color: var(--text-main);
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(203, 213, 225, 0.8) transparent;
    }

    .table-responsive::-webkit-scrollbar {
      height: 6px;
    }
    .table-responsive::-webkit-scrollbar-thumb {
      background: rgba(203, 213, 225, 0.8);
      border-radius: 999px;
    }

    .mail-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.825rem;
    }

    .mail-table th {
      padding: 13px 18px;
      background: var(--glass-white-subtle);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      border-bottom: 1px solid var(--glass-border-subtle);
      white-space: nowrap;
    }

    .mail-table td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--glass-border-subtle);
      vertical-align: middle;
      transition: var(--transition-smooth);
    }

    .mail-table tbody tr {
      transition: var(--transition-smooth);
    }

    .mail-table tbody tr:hover {
      background: var(--glass-row-hover);
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: var(--radius-xs);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.8);
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .badge-in {
      background: var(--accent-blue-subtle);
      color: var(--accent-blue);
      border: 1px solid var(--accent-blue-border);
    }
    .badge-in .badge-dot { background: var(--accent-blue); }

    .badge-out {
      background: var(--accent-emerald-subtle);
      color: var(--accent-emerald);
      border: 1px solid var(--accent-emerald-border);
    }
    .badge-out .badge-dot { background: var(--accent-emerald); }

    .subject-cell {
      max-width: 320px;
    }

    .subject-title {
      font-weight: 600;
      color: var(--text-main);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 2px;
      line-height: 1.35;
    }

    .action-cell {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .icon-btn {
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border: 1px solid var(--glass-border);
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: var(--radius-xs);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02), inset 0 1px 1px rgba(255, 255, 255, 0.95);
      transition: var(--transition-smooth);
    }

    .icon-btn:hover {
      background: #ffffff;
      color: var(--accent-blue);
      border-color: rgba(203, 213, 225, 0.9);
      box-shadow: 0 4px 10px rgba(15, 23, 42, 0.05), inset 0 1px 1px rgba(255, 255, 255, 1);
      transform: translateY(-1px);
    }

