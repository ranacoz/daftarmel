      toast.className = `toast ${type}`;

      let iconSvg = '';
      if (type === 'success') {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>';
      } else if (type === 'warning') {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>';
      } else if (type === 'error') {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>';
      } else {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
      }

      toast.innerHTML = `${iconSvg} <span style="font-size: 0.85rem; font-weight: 500;">${escapeHtml(message)}</span>`;
      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        toast.style.transition = 'all 0.22s ease';
        setTimeout(() => toast.remove(), 240);
      }, 3200);
    }

    if (btnOpenAddModal) {
      btnOpenAddModal.addEventListener('click', openAddModal);
    }

    const btnPickerRecordDate = document.getElementById('btnPickerRecordDate');
    const formRecordDateInput = document.getElementById('formRecordDate');
    if (btnPickerRecordDate && formRecordDateInput) {
      btnPickerRecordDate.addEventListener('click', () => {
        if (typeof formRecordDateInput.showPicker === 'function') {
          formRecordDateInput.showPicker();
        } else {
          formRecordDateInput.focus();
        }
      });
    }

    function openFilterSidebar() {
      if (filterSidebar && filterSidebarOverlay) {
        filterSidebar.classList.add('active');
        filterSidebarOverlay.classList.add('active');
      }
    }

    function closeFilterSidebar() {
      if (filterSidebar && filterSidebarOverlay) {
        filterSidebar.classList.remove('active');
        filterSidebarOverlay.classList.remove('active');
      }
    }

    if (btnOpenFilterSidebar) btnOpenFilterSidebar.addEventListener('click', openFilterSidebar);
    if (btnCloseFilterSidebar) btnCloseFilterSidebar.addEventListener('click', closeFilterSidebar);
    if (filterSidebarOverlay) filterSidebarOverlay.addEventListener('click', closeFilterSidebar);
    if (btnSidebarApply) btnSidebarApply.addEventListener('click', closeFilterSidebar);

    window.openEditModal = function(id) {
      const rec = records.find(r => r.id === id);
      if (!rec) return;

      document.getElementById('recordId').value = rec.id;
      document.getElementById('formType').value = rec.type || 'TERIMAAN';
      document.getElementById('formClassification').value = rec.classification || 'EFT / Pindahan Dalam Talian';
      document.getElementById('formAmount').value = rec.amount || '';
      document.getElementById('formDocDate').value = rec.docDate || '';
      document.getElementById('formRecordDate').value = rec.recordDate || '';
      document.getElementById('formSenderRecipient').value = rec.senderRecipient || '';
      document.getElementById('formSubject').value = rec.subject || '';
      document.getElementById('formNotes').value = rec.notes || '';

      modalTitle.textContent = `Kemaskini Bayaran (${rec.id})`;
      updateLabelSender();
      recordModal.classList.add('active');
    };

    window.confirmDelete = function(id) {
      const rec = records.find(r => r.id === id);
      if (!rec) return;

      pendingDeleteId = id;
      deleteTargetInfo.textContent = `${rec.id} - ${rec.subject} (RM ${formatMoney(rec.amount)})`;
      deleteModal.classList.add('active');
    };

    // Close modal handlers
    if (btnCloseRecordModal) btnCloseRecordModal.addEventListener('click', () => recordModal.classList.remove('active'));
    if (btnCancelRecord) btnCancelRecord.addEventListener('click', () => recordModal.classList.remove('active'));

    if (btnCloseDetailModal) btnCloseDetailModal.addEventListener('click', () => detailModal.classList.remove('active'));
    if (btnCloseDetailBtn) btnCloseDetailBtn.addEventListener('click', () => detailModal.classList.remove('active'));

    if (btnCloseDeleteModal) btnCloseDeleteModal.addEventListener('click', () => deleteModal.classList.remove('active'));
    if (btnCancelDelete) btnCancelDelete.addEventListener('click', () => deleteModal.classList.remove('active'));

    // Filter event listeners inside sidebar
    if (searchInput) searchInput.addEventListener('input', render);
    if (filterPayer) filterPayer.addEventListener('change', render);
    if (filterMonth) filterMonth.addEventListener('change', render);
    if (filterRecordDate) {
      filterRecordDate.addEventListener('change', render);
      filterRecordDate.addEventListener('input', render);
    }
    if (filterClassification) filterClassification.addEventListener('change', render);
    if (filterYear) filterYear.addEventListener('change', render);

    if (dashMonthSelect) dashMonthSelect.addEventListener('change', updateMetrics);
    if (dashYearSelect) dashYearSelect.addEventListener('change', updateMetrics);

    if (btnResetFilters) {
      btnResetFilters.addEventListener('click', () => {
        searchInput.value = '';
        if (filterPayer) filterPayer.value = 'ALL';
        if (filterMonth) filterMonth.value = 'ALL';
        if (filterRecordDate) filterRecordDate.value = '';
        if (filterClassification) filterClassification.value = 'ALL';
        if (filterYear) filterYear.value = 'ALL';
        render();
        showToast('Semua penapis telah dikembalikan ke asal.', 'info');
      });
    }

    if (btnExportCsv) {
      btnExportCsv.addEventListener('click', exportToCSV);
    }

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (searchInput) searchInput.focus();
      }
      if (e.key === 'Escape') {
        closeFilterSidebar();
        recordModal.classList.remove('active');
        detailModal.classList.remove('active');
        deleteModal.classList.remove('active');
      }
    });

    [recordModal, detailModal, deleteModal].forEach(modal => {
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.remove('active');
        });
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      initClock();
      loadRecords();
    });
  </script>
</body>
</html>
