    function exportToCSV() {
      if (records.length === 0) {
        showToast('Tiada rekod bayaran untuk dieksport.', 'warning');
        return;
      }

      const headers = ['Kategori', 'Mod Bayaran', 'Bulan Mod Bayaran', 'Tarikh Terima', 'Penerima/Pembayar', 'Tujuan', 'Amaun (RM)', 'Serahan Kewangan', 'Catatan'];
      
      const rows = records.map(r => [
        `"${r.type || ''}"`,
        `"${r.classification || ''}"`,
        `"${r.docDate || ''}"`,
        `"${r.recordDate || ''}"`,
        `"${(r.senderRecipient || '').replace(/"/g, '""')}"`,
        `"${(r.subject || '').replace(/"/g, '""')}"`,
        `"${r.amount || 0}"`,
        `"${(r.serahKewangan || '').replace(/"/g, '""')}"`,
        `"${(r.notes || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = 'data:text/csv;charset=utf-8,\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `Daftar_Mel_Bayaran_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      showToast('Eksport CSV bayaran berjaya dimuat turun.', 'success');
    }

