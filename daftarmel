    .form-control:focus {
      background: #ffffff;
      border-color: var(--glass-border-focus);
      box-shadow: 0 0 0 3px var(--accent-blue-glow), inset 0 1px 1px rgba(255, 255, 255, 1);
    }

    textarea.form-control {
      min-height: 80px;
      resize: vertical;
    }

    .detail-sheet {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .detail-meta-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      background: rgba(248, 250, 252, 0.75);
      backdrop-filter: blur(var(--glass-blur-sm));
      -webkit-backdrop-filter: blur(var(--glass-blur-sm));
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 16px;
      box-shadow: inset 0 1px 1.5px rgba(255, 255, 255, 0.95);
    }

    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .detail-item .label {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      font-weight: 600;
    }

    .detail-item .value {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .official-stamp {
      border: 1px dashed var(--accent-blue-border);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      text-align: center;
      background: var(--accent-blue-subtle);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      margin-top: 4px;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.9);
    }

    .official-stamp-title {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-blue);
    }

    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 2000;
      pointer-events: none;
    }

    .toast {
      pointer-events: auto;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturate));
      -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(var(--glass-saturate));
      border: 1px solid var(--glass-border);
      color: var(--text-main);
      padding: 12px 18px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: var(--glass-shadow-float), var(--glass-inner-specular);
      min-width: 270px;
      animation: slideInToast 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast.success { border-left: 3px solid var(--accent-emerald); }
    .toast.info { border-left: 3px solid var(--accent-blue); }
    .toast.warning { border-left: 3px solid var(--accent-amber); }
    .toast.error { border-left: 3px solid var(--accent-rose); }

    @keyframes slideInToast {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    @media (max-width: 1024px) {
      .metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      body { padding: 14px; }
      header.main-header { padding: 14px 16px; }
      .metrics-grid { grid-template-columns: 1fr; }
      .form-grid { grid-template-columns: 1fr; }
      .form-group.col-span-2 { grid-column: span 1; }
      .detail-meta-grid { grid-template-columns: 1fr; }
      .modal-content { max-height: 94vh; }
      .filter-sidebar { width: 100%; max-width: 100vw; }
    }

    .print-only {
      display: none;
    }

