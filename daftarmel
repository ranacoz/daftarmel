    function getFilteredRecords() {
      const query = searchInput.value.trim().toLowerCase();
      const payer = filterPayer ? filterPayer.value : 'ALL';
      const month = filterMonth ? filterMonth.value : 'ALL';
      const selectedRecordDate = filterRecordDate ? filterRecordDate.value : '';
      const classification = filterClassification.value;
      const year = filterYear ? filterYear.value : 'ALL';

      const monthsList = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];

      return records.filter(item => {
        if (payer !== 'ALL' && (item.senderRecipient || '').trim() !== payer) return false;
        if (month !== 'ALL') {
          let itemMonth = item.docDate || '';
          if (itemMonth.includes('-')) {
            const mIdx = parseInt(itemMonth.split('-')[1], 10) - 1;
            itemMonth = monthsList[mIdx] || '';
          }
          if (itemMonth !== month) return false;
        }
        if (selectedRecordDate && item.recordDate !== selectedRecordDate) return false;
        if (classification !== 'ALL' && item.classification !== classification) return false;
        if (year !== 'ALL') {
          const recYear = (item.recordDate || '').substring(0, 4);
          const docYear = (item.docDate || '').substring(0, 4);
          if (recYear !== year && docYear !== year) return false;
        }

        if (query) {
          const matchSub = (item.subject || '').toLowerCase().includes(query);
          const matchSender = (item.senderRecipient || '').toLowerCase().includes(query);
          const matchAmt = String(item.amount || '').includes(query);
          if (!matchSub && !matchSender && !matchAmt) {
            return false;
          }
        }
        return true;
      });
    }

