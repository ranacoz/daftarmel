    function loadRecords() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
          records = JSON.parse(stored);
        } else {
          records = [...DEFAULT_DATA];
          saveRecords();
        }
      } catch (err) {
        console.error('Ralat membaca simpanan data:', err);
        records = [...DEFAULT_DATA];
      }
      populateYearFilter();
      populatePayerFilter();
      render();
    }

    function saveRecords() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
      } catch (err) {
        showToast('Gagal menyimpan rekod ke storan pelayar.', 'error');
      }
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      const parts = String(dateStr).split('-');
      if (parts.length === 3) {
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
      }
      return dateStr;
    }

    function formatMonth(val) {
      if (!val) return '-';
      const monthsList = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];
      if (val.includes('-')) {
        const parts = val.split('-');
        if (parts.length >= 2) {
          const mIdx = parseInt(parts[1], 10) - 1;
          return monthsList[mIdx] || val;
        }
      }
      return val;
    }

    function formatMoney(amount) {
      const num = parseFloat(amount || 0);
      return num.toLocaleString('ms-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function initClock() {
      function update() {
        const now = new Date();
        const days = ['Ahad', 'Isnin', 'Selasa', 'Rabu', 'Khamis', 'Jumaat', 'Sabtu'];
        const months = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];
        
        const dayName = days[now.getDay()];
        const dayDate = String(now.getDate()).padStart(2, '0');
        const monthName = months[now.getMonth()];
        const year = now.getFullYear();

        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');

        const dateEl = document.getElementById('currentDateText');
        const timeEl = document.getElementById('currentTimeText');
        if (dateEl) dateEl.textContent = `${dayName}, ${dayDate} ${monthName} ${year}`;
        if (timeEl) timeEl.textContent = `${hours}:${minutes}:${seconds}`;
      }
      update();
      setInterval(update, 1000);
    }

    function updateMetrics() {
      const monthsList = ['Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun', 'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'];
      const now = new Date();
      const currentMonth = monthsList[now.getMonth()];
      const currentYear = String(now.getFullYear());

      const activeMonth = (dashMonthSelect && dashMonthSelect.value) ? dashMonthSelect.value : currentMonth;
      const activeYear = (dashYearSelect && dashYearSelect.value) ? dashYearSelect.value : currentYear;

      const total = records.length;
      const recordsInMonth = records.filter(r => {
        if (r.type !== 'TERIMAAN') return false;

        let itemMonth = r.docDate || '';
        if (itemMonth.includes('-')) {
          const mIdx = parseInt(itemMonth.split('-')[1], 10) - 1;
          itemMonth = monthsList[mIdx] || '';
        }
        if (itemMonth.toLowerCase() !== activeMonth.toLowerCase()) return false;

        if (activeYear) {
          const recYear = (r.recordDate || '').substring(0, 4);
          const docYear = (r.docDate || '').substring(0, 4);
          if (recYear !== activeYear && docYear !== activeYear) return false;
        }

        return true;
      });

      const sumIn = recordsInMonth.reduce((acc, r) => acc + (parseFloat(r.amount) || 0), 0);

      document.getElementById('statTotal').textContent = total;
      document.getElementById('statIn').textContent = recordsInMonth.length;
      document.getElementById('statInSum').textContent = `RM ${formatMoney(sumIn)}`;

      const statMonthTitle = document.getElementById('statMonthTitle');
      if (statMonthTitle) {
        statMonthTitle.textContent = `Terimaan Bayaran (${activeMonth} ${activeYear})`;
      }
    }

    function populateYearFilter() {
      const currentSelected = filterYear ? filterYear.value : 'ALL';
      const currentDashSelected = dashYearSelect ? dashYearSelect.value : '';
      const years = new Set();

      records.forEach(r => {
        const y1 = (r.recordDate || '').substring(0, 4);
        const y2 = (r.docDate || '').substring(0, 4);
        if (y1 && !isNaN(y1)) years.add(y1);
        if (y2 && !isNaN(y2)) years.add(y2);
      });
      years.add(String(new Date().getFullYear()));

      const sortedYears = Array.from(years).sort((a, b) => b.localeCompare(a));
      
      if (filterYear) {
        let html = '<option value="ALL">Semua Tahun</option>';
        sortedYears.forEach(y => {
          html += `<option value="${y}">Tahun ${y}</option>`;
        });
        filterYear.innerHTML = html;

        if (sortedYears.includes(currentSelected)) {
          filterYear.value = currentSelected;
        } else {
          filterYear.value = 'ALL';
        }
      }

      if (dashYearSelect) {
        let dashHtml = '';
        sortedYears.forEach(y => {
          dashHtml += `<option value="${y}">${y}</option>`;
        });
        dashYearSelect.innerHTML = dashHtml;

        if (currentDashSelected && sortedYears.includes(currentDashSelected)) {
          dashYearSelect.value = currentDashSelected;
        } else {
          const thisYear = String(new Date().getFullYear());
          dashYearSelect.value = sortedYears.includes(thisYear) ? thisYear : sortedYears[0];
        }
      }
    }

    function populatePayerFilter() {
      if (!filterPayer) return;
      const currentSelected = filterPayer.value;
      const payers = new Set();

      records.forEach(r => {
        const p = (r.senderRecipient || '').trim();
        if (p) payers.add(p);
      });

      const sortedPayers = Array.from(payers).sort((a, b) => a.localeCompare(b));
      let html = '<option value="ALL">Semua Pembayar</option>';
      sortedPayers.forEach(p => {
        html += `<option value="${escapeHtml(p)}">${escapeHtml(p)}</option>`;
      });
      filterPayer.innerHTML = html;

      if (sortedPayers.includes(currentSelected)) {
        filterPayer.value = currentSelected;
      } else {
        filterPayer.value = 'ALL';
      }
    }

    function updateActiveFilterBadge() {
      let count = 0;
      if (filterPayer && filterPayer.value !== 'ALL') count++;
      if (filterMonth && filterMonth.value !== 'ALL') count++;
      if (filterRecordDate && filterRecordDate.value) count++;
      if (filterClassification && filterClassification.value !== 'ALL') count++;
      if (filterYear && filterYear.value !== 'ALL') count++;

      if (activeFilterBadge) {
        if (count > 0) {
          activeFilterBadge.textContent = count;
          activeFilterBadge.classList.remove('hidden');
        } else {
          activeFilterBadge.textContent = '0';
          activeFilterBadge.classList.add('hidden');
        }
      }
